<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <!-- Connection string lives HERE (never hard-coded in C#).
       Default = Windows authentication, so no password is stored in the repository.
       Change Data Source to your server, for example:
         .\SQLEXPRESS            SQL Server Express
         (localdb)\MSSQLLocalDB  Visual Studio LocalDB
         localhost               SQL Server Developer/Standard
       For SQL authentication use: User Id=YOUR_USER;Password=YOUR_PASSWORD;  (do NOT commit real passwords) -->
  <connectionStrings>
    <add name="WholesaleDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=WholesaleDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=10"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Account is locked after this many wrong passwords in a row -->
    <add key="MaxFailedLogins" value="5" />
    <!-- Items with StockQuantity at or below this value are shown in the low-stock warning -->
    <add key="LowStockThreshold" value="20" />
    <add key="CompanyName" value="B2B Wholesale Distribution Co." />
    <add key="CompanyAddress" value="12 Nguyen Van Linh, District 7, Ho Chi Minh City" />
    <add key="CompanyPhone" value="028 3999 8888" />
  </appSettings>
</configuration>
