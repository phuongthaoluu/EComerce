
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Wholesale Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            header nav.wh-navbar {
                background: linear-gradient(90deg, #e7a2bd, #f0bfd2) !important;
                border-bottom: 1px solid #d98eac !important;
                box-shadow: 0 4px 15px rgba(160, 80, 115, 0.15);
                padding-top: 14px;
                padding-bottom: 14px;
            }

            header .wh-navbar .navbar-brand {
                color: #69364d !important;
                font-weight: 700;
                font-size: 20px;
            }

            header .wh-navbar .nav-link {
                color: #784159 !important;
                font-weight: 500;
                padding: 8px 14px !important;
                border-radius: 10px;
                transition: 0.2s;
            }

                header .wh-navbar .nav-link:hover {
                    color: #853b5b !important;
                    background: rgba(255, 255, 255, 0.35);
                }

            header .wh-navbar .wh-username {
                color: #69364d !important;
                font-weight: 600;
            }

            header .wh-navbar .wh-nav-btn {
                background: #ffffff;
                color: #a45179;
                border: 1px solid #d98eac;
                border-radius: 10px;
                padding: 7px 20px;
                font-weight: 600;
                transition: 0.2s;
            }

                header .wh-navbar .wh-nav-btn:hover {
                    background: #bc6f93;
                    color: #ffffff;
                    border-color: #bc6f93;
                }

            header .wh-navbar .navbar-toggler {
                border-color: #c87b9b;
            }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light wh-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Wholesale Portal
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMenu"
                        aria-controls="navbarMenu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Catalog"
                               asp-action="Index">
                                Catalog
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Orders"
                               asp-action="Create">
                                Create Order
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="MyOrders"
                               asp-action="Index">
                                My Orders
                            </a>
                        </li>
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text wh-username me-3">
                            @User.Identity.Name
                        </span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn wh-nav-btn">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn wh-nav-btn"
                           asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>
                    }

                </div>
            </div>
        </nav>
    </header>

    <main class="container page-content py-4">
        @RenderBody()
    </main>

    <footer class="border-top text-muted py-3">
        <div class="container text-center">
            &copy; 2026 - B2B Wholesale Management System
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
