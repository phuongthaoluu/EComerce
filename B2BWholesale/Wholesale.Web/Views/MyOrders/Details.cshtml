@model Wholesale.Web.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">
    <h2>Order Details #@Model.OrderID</h2>

    <p>Order Date: @Model.OrderDate.ToString("dd/MM/yyyy")</p>

    <p>Status: @Model.OrderStatus</p>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Item</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitAmount.ToString("N0") VND</td>
                    <td>@item.Amount.ToString("N0") VND</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="text-end">
        Total: @Model.TotalAmount.ToString("N0") VND
    </h4>

    <a asp-controller="MyOrders"
       asp-action="Index"
       class="btn btn-secondary">
        Back to My Orders
    </a>
</div>
