
@model Wholesale.Web.ViewModels.OrderDetailsViewModel

@{
    ViewData["Title"] = "Order Details";
}

<style>
    .details-page {
        font-family: 'Segoe UI', Arial, sans-serif;
        padding: 20px 0 55px;
    }

    .details-header {
        background: linear-gradient(120deg, #fff0f6, #ffffff);
        border: 1px solid #f1dce6;
        border-radius: 22px;
        padding: 35px;
        margin-bottom: 28px;
    }

    .details-label {
        color: #b97596;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        margin-bottom: 12px;
    }

    .details-title {
        color: #63374d;
        font-size: 35px;
        font-weight: 800;
        letter-spacing: -1px;
        margin-bottom: 0;
    }

    .details-id {
        color: #b45e87;
    }

    .details-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 28px;
    }

    .details-info-card {
        background: #ffffff;
        border: 1px solid #f0dce6;
        border-radius: 17px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(180, 110, 145, 0.05);
    }

    .details-info-label {
        color: #a08a95;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .details-info-value {
        color: #63374d;
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 0;
    }

    .details-status {
        display: inline-block;
        background: #f5edf2;
        color: #94677f;
        padding: 9px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .details-status[data-status="Pending"] {
        background: #fff2d9;
        color: #97650d;
    }

    .details-status[data-status="Confirmed"] {
        background: #eee9ff;
        color: #7659a5;
    }

    .details-status[data-status="Shipped"] {
        background: #eaf2ff;
        color: #426ba6;
    }

    .details-status[data-status="Delivered"] {
        background: #e7f7ec;
        color: #328553;
    }

    .details-status[data-status="Cancelled"] {
        background: #ffeaee;
        color: #bc5267;
    }

    .details-container {
        background: #ffffff;
        border: 1px solid #f0dce6;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(180, 110, 145, 0.07);
    }

    .details-container-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 24px 28px;
        border-bottom: 1px solid #f4e4eb;
    }

    .details-container-title {
        color: #63374d;
        font-size: 18px;
        font-weight: 700;
        margin: 0;
    }

    .details-count {
        background: #fff0f6;
        color: #b16b8d;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .details-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
    }

    .details-table thead {
        background: #fff4f8;
    }

    .details-table th {
        color: #8d5b74;
        padding: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        border-bottom: 1px solid #efdce5;
    }

    .details-table td {
        padding: 22px 20px;
        vertical-align: middle;
        border-bottom: 1px solid #f4e8ee;
        color: #73576a;
        font-size: 14px;
    }

    .details-table tbody tr:last-child td {
        border-bottom: none;
    }

    .details-table tbody tr:hover {
        background: #fffafd;
    }

    .details-item-name {
        color: #63374d;
        font-weight: 700;
    }

    .details-quantity {
        display: inline-block;
        background: #f9edf3;
        color: #98617d;
        padding: 8px 14px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
    }

    .details-price {
        color: #826775;
        white-space: nowrap;
    }

    .details-amount {
        color: #b45e87 !important;
        font-weight: 700;
        white-space: nowrap;
    }

    .details-summary {
        background: linear-gradient(120deg, #fff3f8, #ffffff);
        border: 1px solid #f0dce6;
        border-radius: 20px;
        padding: 30px;
        margin-top: 26px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .details-total-label {
        color: #987587;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .details-total {
        color: #a94f7d;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -1px;
        margin: 0;
    }

    .details-total-note {
        color: #b28da0;
        font-size: 12px;
    }

    .details-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 25px;
    }

    .details-print-btn {
        background: linear-gradient(110deg, #d88eaf, #c8799d);
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 15px 28px;
        font-size: 14px;
        font-weight: 700;
        transition: 0.2s;
    }

    .details-print-btn:hover {
        background: linear-gradient(110deg, #ca7ba0, #b86991);
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(190, 110, 150, 0.18);
    }

    .details-back-btn {
        display: inline-block;
        background: #ffffff;
        color: #96627e;
        border: 1px solid #e7c5d5;
        border-radius: 12px;
        padding: 15px 25px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

    .details-back-btn:hover {
        background: #fff0f6;
        color: #a94f7d;
        border-color: #dca5bf;
    }

    .details-print-heading {
        display: none;
    }

    @@media (max-width: 767px) {
        .details-header {
            padding: 25px;
        }

        .details-title {
            font-size: 28px;
        }

        .details-info {
            grid-template-columns: 1fr;
        }

        .details-container-header {
            padding: 20px;
        }

        .details-table th,
        .details-table td {
            padding: 15px;
        }

        .details-summary {
            flex-direction: column;
            align-items: flex-start;
            padding: 25px 20px;
        }

        .details-total {
            font-size: 27px;
        }

        .details-actions {
            flex-direction: column;
        }

        .details-print-btn,
        .details-back-btn {
            width: 100%;
            text-align: center;
        }
    }

    @@media print {
        .no-print,
        header,
        footer,
        nav {
            display: none !important;
        }

        body {
            background-color: #ffffff !important;
            color: #000000 !important;
            margin: 0 !important;
        }

        main.container {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .details-page {
            padding: 0 !important;
        }

        .details-header {
            background: #ffffff !important;
            border: none !important;
            border-radius: 0 !important;
            padding: 0 0 20px !important;
            margin-bottom: 20px !important;
        }

        .details-label {
            display: none !important;
        }

        .details-title {
            display: none !important;
        }

        .details-print-heading {
            display: block !important;
            color: #000000 !important;
            font-size: 28px;
            font-weight: 800;
            text-align: center;
            margin-bottom: 10px;
        }

        .details-info {
            gap: 10px;
            margin-bottom: 20px;
        }

        .details-info-card {
            border: 1px solid #cccccc !important;
            border-radius: 0 !important;
            padding: 15px !important;
            box-shadow: none !important;
        }

        .details-info-label,
        .details-info-value,
        .details-status {
            color: #000000 !important;
        }

        .details-status {
            background: #ffffff !important;
            border: 1px solid #cccccc !important;
        }

        .details-container {
            border: 1px solid #cccccc !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            overflow: visible !important;
        }

        .details-container-header {
            padding: 15px !important;
        }

        .details-container-title {
            color: #000000 !important;
        }

        .details-count {
            display: none !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        .details-table {
            width: 100% !important;
            border-collapse: collapse !important;
        }

        .details-table thead {
            background: #ffffff !important;
        }

        .details-table th,
        .details-table td {
            color: #000000 !important;
            background: #ffffff !important;
            border: 1px solid #cccccc !important;
            padding: 12px !important;
        }

        .details-table thead {
            display: table-header-group;
        }

        .details-table tr {
            break-inside: avoid;
        }

        .details-item-name,
        .details-price,
        .details-amount {
            color: #000000 !important;
        }

        .details-quantity {
            color: #000000 !important;
            background: #ffffff !important;
            padding: 0 !important;
        }

        .details-summary {
            background: #ffffff !important;
            border: none !important;
            border-top: 2px solid #000000 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            padding: 20px 0 !important;
            margin-top: 20px !important;
        }

        .details-total-label,
        .details-total {
            color: #000000 !important;
        }

        .details-total-note {
            display: none !important;
        }
    }
</style>

<div class="details-page">

    <div class="details-header">

        <div class="details-label">
            ORDER MANAGEMENT
        </div>

        <h1 class="details-title">
            Order Details
            <span class="details-id">
                #@Model.OrderID
            </span>
        </h1>

        <h1 class="details-print-heading">
            INVOICE #@Model.OrderID
        </h1>

    </div>

    <div class="details-info">

        <div class="details-info-card">

            <div class="details-info-label">
                Order Date
            </div>

            <p class="details-info-value">
                @Model.OrderDate.ToString("dd/MM/yyyy")
            </p>

        </div>

        <div class="details-info-card">

            <div class="details-info-label">
                Order Status
            </div>

            <span class="details-status"
                  data-status="@Model.OrderStatus">
                @Model.OrderStatus
            </span>

        </div>

    </div>

    <div class="details-container">

        <div class="details-container-header">

            <h2 class="details-container-title">
                Order Items
            </h2>

            <span class="details-count">
                @Model.Items.Count() Items
            </span>

        </div>

        <div class="table-responsive">

            <table class="details-table">

                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Amount</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>
                                <span class="details-item-name">
                                    @item.ItemName
                                </span>
                            </td>

                            <td>
                                <span class="details-quantity">
                                    @item.Quantity
                                </span>
                            </td>

                            <td>
                                <span class="details-price">
                                    @item.UnitAmount.ToString("N0") VND
                                </span>
                            </td>

                            <td>
                                <span class="details-amount">
                                    @item.Amount.ToString("N0") VND
                                </span>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="details-summary">

        <div>

            <div class="details-total-label">
                Total Order Amount
            </div>

            <h3 class="details-total">
                @Model.TotalAmount.ToString("N0") VND
            </h3>

        </div>

        <span class="details-total-note">
            Order #@Model.OrderID
        </span>

    </div>

    <div class="details-actions no-print">

        <button type="button"
                class="details-print-btn"
                onclick="window.print()">
            Print Invoice
        </button>

        <a asp-controller="MyOrders"
           asp-action="Index"
           class="details-back-btn">
            Back to My Orders
        </a>

    </div>

</div>
